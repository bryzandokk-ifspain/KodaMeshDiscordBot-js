# Discord application
TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
# Optional: used for startup logging and clearing an old guild-specific command registration
GUILD_ID=

# Roblox Open Cloud
ROBLOX_API_KEY=YOUR_ROBLOX_OPEN_CLOUD_API_KEY
# Your Roblox user ID, or your group ID when ROBLOX_IS_GROUP=true
ROBLOX_CREATOR_ID=YOUR_ROBLOX_USER_OR_GROUP_ID
ROBLOX_IS_GROUP=false
# Experience identifiers used by /portpack and /imagetomesh3id
ROBLOX_UNIVERSE_ID=YOUR_ROBLOX_UNIVERSE_ID
ROBLOX_PLACE_ID=YOUR_ROBLOX_START_PLACE_ID

# Optional: only required by /aichat
OPENAI_API_KEY=
# Optional model override; defaults to the model configured in commands/aichat.js
OPENAI_MODEL=
